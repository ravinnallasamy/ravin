# ---------------------------------------------------------------------------
# Existing site integrations (EmailJS contact form)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: legacy single-account GitHub stats (lib/github.ts)
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Unified GitHub Developer Dashboard (github-dashboard/)
# SERVER-ONLY. These are never prefixed NEXT_PUBLIC_ and never reach the client.
# ---------------------------------------------------------------------------

# --- Account 1 (required) ---
GITHUB_USERNAME_PRIMARY=your-primary-username
# Fine-grained or classic PAT. Scopes: read:user, repo (for private repos),
# read:org. Used only server-side for authenticated REST + GraphQL calls.
GITHUB_TOKEN_PRIMARY=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Account 2 (optional; both username AND token required to be included) ---
GITHUB_USERNAME_SECONDARY=your-secondary-username
GITHUB_TOKEN_SECONDARY=ghp_yyyyyyyyyyyyyyyyyyyy

# Refresh cadence for the merged snapshot. One of: hourly | 6h | 12h | daily
# Unrecognised/blank values fall back to "6h". Controls cache TTL, ISR
# revalidate, and the in-process scheduler interval.
GITHUB_REFRESH_INTERVAL=6h

# Secret guarding POST /api/github-dashboard/refresh (external cron trigger).
# If unset, that endpoint is disabled (returns 403) rather than left open.
GITHUB_DASHBOARD_REFRESH_SECRET=

# Optional: ISO 8601 date (e.g. 2026-04-01) recording when GITHUB_TOKEN_PRIMARY
# / GITHUB_TOKEN_SECONDARY were last rotated. Used only by tokenHealth.ts to
# surface a rotation-overdue reminder; update it by hand whenever you reissue
# a token. Leave unset if you don't track this.
GITHUB_TOKEN_LAST_ROTATED=

# Optional: bearer secret for GET /api/github-dashboard/health. Without it,
# the health route only returns full config/rotation details to non-production
# or loopback requests; in production, a caller with this secret can still
# fetch full details, everyone else gets a coarse { status } only.
GITHUB_DASHBOARD_HEALTH_SECRET=

# ---------------------------------------------------------------------------
# LeetCode Analytics Dashboard (leetcode-dashboard/)
# Uses ONLY LeetCode's PUBLIC GraphQL endpoint — no auth, cookies, or CSRF.
# None of these are NEXT_PUBLIC_-prefixed; they never reach the client bundle.
# ---------------------------------------------------------------------------

# LeetCode username to analyse. If blank, falls back to the handle parsed from
# content/social.json:leetcodeUsername (the same source lib/leetcode.ts uses).
LEETCODE_USERNAME=

# Refresh cadence for the LeetCode snapshot, in SECONDS. Default 21600 (6h).
# Controls cache TTL, ISR revalidate, and the in-process scheduler interval.
# Clamped to [300, 604800] (5 min .. 7 days); invalid/blank -> 21600.
LEETCODE_REFRESH_INTERVAL=21600

# Optional: secret guarding POST /api/leetcode-dashboard/refresh (external cron
# trigger). If unset, that endpoint is disabled (returns 403) rather than left
# open. Send `Authorization: Bearer <secret>` to trigger a forced refresh.
LEETCODE_DASHBOARD_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Resume Chat Widget (components/ui/ResumeChatWidget.tsx)
# ---------------------------------------------------------------------------

# Base URL of the resume-chat backend (no trailing path), e.g.
# https://ravin-assistant-backend-1.onrender.com
# The widget POSTs to `${this}/api/public/ask` with { "question": string }
# and expects { "success": true, "answer": string, ... } — see backend's
# POST /api/public/ask docs for the full contract (voice mode, error shapes,
# rate limiting). NEXT_PUBLIC_-prefixed because the widget calls it directly
# from the browser. If unset, falls back to the local placeholder route at
# /api/resume-chat.
NEXT_PUBLIC_RESUME_CHAT_API_URL=
